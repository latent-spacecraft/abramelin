<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow network access for web server -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow file access for reading/writing protein files -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow spawning child processes (Python) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required for JIT compilation in MLX/PyTorch -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Disable library validation for Python packages -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
